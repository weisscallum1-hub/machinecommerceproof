# Machine Commerce Proof runtime configuration
NODE_ENV=production
PORT=4020
DATA_DIR=/app/data

# Set this only to the browser/app origin(s) that should call the API.
# Omit for a server-to-server deployment with no browser CORS requirement.
CORS_ORIGIN=https://your-console.example

# Generate strong random values. Never commit real values.
PROOF_WRITE_TOKEN=replace-with-a-high-entropy-secret
ADMIN_TOKEN=replace-with-a-different-high-entropy-secret

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Set true only when the service is behind a proxy whose forwarded client IP headers you control.
TRUST_PROXY=false
